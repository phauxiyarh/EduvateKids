rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // Role is stored on the user's own /users/{uid} doc (set by admin tooling).
    // Backward-compatible: a signed-in user whose /users doc is missing or has no
    // `role` is treated as admin (matches the app's historical default), so the
    // existing owner account is never locked out. Explicit 'cashier' is limited.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function roleOrDefault() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && ('role' in userDoc().data)
             ? userDoc().data.role
             : 'admin';
    }
    function isAdmin() {
      return signedIn() && roleOrDefault() == 'admin';
    }
    // Staff = admin or cashier (operational access to store data).
    function isStaff() {
      return signedIn() && (roleOrDefault() == 'admin' || roleOrDefault() == 'cashier');
    }

    // ── User profiles ─────────────────────────────────────────────────────
    // A user may read/update their own profile, but MUST NOT escalate their own
    // role. Only admins can set/change roles (or create other users' docs).
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && request.resource.data.get('role', 'admin')
                           == resource.data.get('role', 'admin'));
    }

    // ── Public config (read by anyone signed in; writes admin-only) ─────────
    match /public/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Dashboard aggregates (staff read; admin write) ──────────────────────
    match /dashboard/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Store operations: staff read; writes admin-only ─────────────────────
    // Cashiers operate the POS (which records sales/orders) but should not be
    // able to rewrite the master inventory/event catalogue; that stays admin.
    match /inventory/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /events/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /generalSales/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /generalOrders/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /backups/{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Catalog: public read, admin write ───────────────────────────────────
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contact messages: public create (validated), staff read, admin manage ─
    match /contactMessages/{document=**} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','email','message','subject','phone','createdAt','_live'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000;
    }

    // ── Event bookings: public create (bounded), staff read, admin manage ────
    match /eventBookings/{document=**} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.size() <= 30
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200;
    }

    // ── Orders: created ONLY by Cloud Functions (Admin SDK bypasses rules) ───
    // Orders hold customer PII + addresses, so reads are ADMIN-ONLY (a cashier
    // does not need every customer's address). Clients can never forge an order.
    match /orders/{document=**} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Summer Reads registrations ──────────────────────────────────────────
    // - Registration + book logging normally go through Cloud Functions (Admin
    //   SDK, bypasses rules). This public create is a tightly-validated fallback.
    // - Public may READ a single doc by code (progress view) but NOT list.
    // - Updates/deletes are ADMIN-ONLY (logging is via logSummerBook function).
    match /summerReads/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.childName is string
                    && request.resource.data.childName.size() > 0
                    && request.resource.data.childName.size() <= 120
                    && request.resource.data.parentEmail is string
                    && request.resource.data.parentEmail.size() <= 200
                    && request.resource.data.booksCount == 0
                    && request.resource.data.tier == 'none'
                    && request.resource.data.booksLogged is list
                    && request.resource.data.booksLogged.size() == 0
                    && (!('_live' in request.resource.data) || request.resource.data._live == true);
      allow update, delete: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
