rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // Role lives on the user's own /users/{uid} doc. A signed-in user with NO
    // /users doc (or no `role`) is treated as an ordinary user, NOT admin, so a
    // self-registered account can never gain admin by absence of data.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userRole() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && ('role' in userDoc().data)
             ? userDoc().data.role
             : '';
    }
    // Bootstrap escape hatch: the founding owner's verified email is always
    // admin, so seeding the owner's /users doc can never lock anyone out. Keep
    // this list minimal and remove once every admin has an explicit role doc.
    function isBootstrapAdmin() {
      return signedIn()
             && request.auth.token.email_verified == true
             && request.auth.token.email in ['ismailukman@gmail.com'];
    }
    function isAdmin() {
      return signedIn() && (userRole() == 'admin' || isBootstrapAdmin());
    }
    // Staff = admin or cashier (operational access to store data).
    function isStaff() {
      return isAdmin() || (signedIn() && userRole() == 'cashier');
    }

    // ── User profiles ─────────────────────────────────────────────────────
    // A user may read/update their own profile but can NEVER change the `role`
    // field (that is admin-only). Only admins create/delete other users' docs.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    // ── Public config (read by anyone signed in; writes admin-only) ─────────
    match /public/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Dashboard aggregates (staff read; admin write) ──────────────────────
    match /dashboard/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Store operations: staff read; writes admin-only ─────────────────────
    match /inventory/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /events/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /generalSales/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /generalOrders/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /backups/{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Catalog: public read, admin write ───────────────────────────────────
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contact messages: public create (validated + bounded), staff read ───
    // Direct public writes are field-allow-listed and size-bounded. Abuse/spam
    // is further limited by Firebase App Check enforcement (configured in the
    // console); enable it so only the real front end can write here.
    match /contactMessages/{document=**} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','email','message','subject','phone','createdAt','_live'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && (!('subject' in request.resource.data) || request.resource.data.subject.size() <= 200)
                    && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 40);
    }

    // ── Event bookings: public create (field-allow-listed + bounded) ────────
    match /eventBookings/{document=**} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','email','phone','organization','eventType','eventDate',
                         'location','message','attendees','createdAt','_live','status'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)
                    && (!('message' in request.resource.data) || request.resource.data.message.size() <= 5000);
    }

    // ── Orders: created ONLY by Cloud Functions (Admin SDK bypasses rules) ───
    // Orders hold customer PII + addresses, so reads/writes are ADMIN-ONLY.
    match /orders/{document=**} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Summer Reads registrations ──────────────────────────────────────────
    // Registration + book logging go through Cloud Functions (Admin SDK). The
    // public direct-create fallback is REMOVED so the child/parent PII in these
    // docs cannot be forged or spammed from the client. Public `get` by code is
    // kept for the progress view; treat the doc as holding PII (a code holder
    // sees it). Only admins may list/update/delete.
    match /summerReads/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
