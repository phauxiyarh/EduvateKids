rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // Role lives on the user's own /users/{uid} doc. A signed-in user with NO
    // /users doc (or no `role`) is treated as an ordinary user, NOT admin, so a
    // self-registered account can never gain admin by absence of data.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userRole() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && ('role' in userDoc().data)
             ? userDoc().data.role
             : '';
    }
    // Bootstrap escape hatch: the founding owner's verified email is always
    // admin, so seeding the owner's /users doc can never lock anyone out. Keep
    // this list minimal and remove once every admin has an explicit role doc.
    function isBootstrapAdmin() {
      return signedIn()
             && request.auth.token.email_verified == true
             && request.auth.token.email in ['admin@eduvatekids.com', 'eduvatekids@gmail.com'];
    }
    function isAdmin() {
      return signedIn() && (userRole() == 'admin' || isBootstrapAdmin());
    }
    // Staff = admin or cashier (operational access to store data).
    function isStaff() {
      return isAdmin() || (signedIn() && userRole() == 'cashier');
    }

    // ── User profiles ─────────────────────────────────────────────────────
    // A user may read/update their own profile but can NEVER change the `role`
    // field (that is admin-only). Only admins create/delete other users' docs.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    // ── Public config (read by anyone signed in; writes admin-only) ─────────
    match /public/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Dashboard aggregates (staff read; admin write) ──────────────────────
    match /dashboard/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Store operations: staff read; writes admin-only ─────────────────────
    match /inventory/{document=**} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /events/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /generalSales/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /generalOrders/{document=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /backups/{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Catalog: public read, admin write ───────────────────────────────────
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Shelves: public read, admin write ───────────────────────────────────
    // Curated collections shown on /shelves. Read publicly so the storefront
    // and the build-time page generator can list them without credentials.
    match /shelves/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Blog: public read, admin write ──────────────────────────────────────
    // Visitors can read posts but cannot write anything, including `likes`.
    // Public likes go through the likeBlogPost callable, which increments by
    // exactly one; admins may set the count directly, which is intended.
    match /blog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Customer reviews ────────────────────────────────────────────────────
    // Created ONLY by the createReview Cloud Function (Admin SDK bypasses these
    // rules), which forces `approved: false` — so a visitor can never publish
    // straight to the site or self-approve.
    //
    // The review doc itself holds only publishable fields (name, role, rating,
    // quote, approved, featured). Reads are public so the storefront can list
    // approved reviews live and the build-time generator can read them without
    // credentials.
    //
    // Rules cannot hide a field, only a document, so the reviewer's email and
    // the submitter IP are deliberately NOT stored here. They go in
    // reviews/{id}/private/contact, which is admin-only (see below). Without
    // that split, making a review publicly readable would publish the email.
    match /reviews/{reviewId} {
      // `read` covers both get and list. For a list, Firestore evaluates this
      // per candidate document and rejects the whole query if any document
      // fails, so any public read must be constrained to approved reviews:
      // the client sends `where('approved','==',true)` and the build-time
      // generator sends the same filter via runQuery (see
      // lib/catalogBuild.ts getApprovedReviews). An unfiltered list is refused,
      // and pending reviews are visible only to an admin.
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();

      // Reviewer contact details. Written by the createReview function via the
      // Admin SDK; readable only by an admin following up on a review.
      match /private/{document=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ── Review rate-limit log ───────────────────────────────────────────────
    // One doc per submission holding the IP and a timestamp, used only by
    // createReview to throttle floods. Never client-readable.
    match /reviewSubmissions/{document=**} {
      allow read, write: if false;
    }

    // ── Freebies: public read, admin write ──────────────────────────────────
    // The metadata is public so the /freebies page can list them, but
    // `filePath` points at a Storage object that is NOT publicly readable.
    // Knowing the path grants nothing without a signed URL from
    // getFreebieDownload.
    match /freebies/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Subscribers: never publicly readable ────────────────────────────────
    // Email addresses collected at the freebie gate. Written only by the
    // getFreebieDownload function via the Admin SDK, which bypasses these
    // rules; no client path may read or write them.
    match /subscribers/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── System state: admin read only, written by Cloud Functions ───────────
    // Editable email templates (currently the Summer Reads reminder). The admin
    // reads the saved copy into the dashboard editor; writes go through the
    // saveReminderTemplate callable so the payload is validated and normalised
    // before it becomes the template every broadcast renders from.
    match /emailTemplates/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Holds system/publishState, which tells the dashboard whether the static
    // product pages are behind the catalog. Only the Admin SDK writes here.
    match /system/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Contact messages: public create (validated + bounded), staff read ───
    // Direct public writes are field-allow-listed and size-bounded. Abuse/spam
    // is further limited by Firebase App Check enforcement (configured in the
    // console); enable it so only the real front end can write here.
    match /contactMessages/{document=**} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','email','message','subject','phone','createdAt','_live'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && (!('subject' in request.resource.data) || request.resource.data.subject.size() <= 200)
                    && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 40);
    }

    // ── Event bookings: public create (field-allow-listed + bounded) ────────
    match /eventBookings/{document=**} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','email','phone','organization','eventType','eventDate',
                         'location','message','attendees','createdAt','_live','status'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)
                    && (!('message' in request.resource.data) || request.resource.data.message.size() <= 5000);
    }

    // ── Orders: created ONLY by Cloud Functions (Admin SDK bypasses rules) ───
    // Orders hold customer PII + addresses, so reads/writes are ADMIN-ONLY.
    match /orders/{document=**} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Summer Reads registrations ──────────────────────────────────────────
    // Registration + book logging go through Cloud Functions (Admin SDK). The
    // public direct-create fallback is REMOVED so the child/parent PII in these
    // docs cannot be forged or spammed from the client. Public `get` by code is
    // kept for the progress view; treat the doc as holding PII (a code holder
    // sees it). Only admins may list/update/delete.
    match /summerReads/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── Book requests (out-of-stock pre-orders) ─────────────────────────────
    // Created ONLY by the submitBookRequest Cloud Function (Admin SDK bypasses
    // rules). Holds shopper PII (name/email/phone), so reads are ADMIN-ONLY and
    // clients may never create/update/delete directly.
    match /bookRequests/{document=**} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
