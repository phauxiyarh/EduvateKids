rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images: public read (shown on the storefront/catalogue),
    // authenticated write (admin uploads from the dashboard). Limit to images
    // under 8MB to prevent abuse.
    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Blog images: public read (shown in articles), authenticated write.
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Freebie cover art. The resources themselves live on Google Drive and are
    // never uploaded here, so a cover is just another public marketing image.
    match /freebie-covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
