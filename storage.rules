rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images: public read (shown on the storefront/catalogue),
    // authenticated write (admin uploads from the dashboard). Limit to images
    // under 8MB to prevent abuse.
    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Blog images: public read (shown in articles), authenticated write.
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Freebie cover art advertises the download, so it is public like any
    // other marketing image.
    match /freebie-covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // The freebie files themselves are NOT publicly readable. Access is granted
    // only through a short-lived signed URL minted by the getFreebieDownload
    // function after the visitor has subscribed. Public read here would let
    // anyone share a permanent link and bypass the email gate entirely.
    // No content-type restriction: these are PDFs, zips and worksheets.
    match /freebies/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Everything else denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
