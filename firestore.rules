rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow all authenticated users to read public data
    match /public/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Dashboard data - authenticated users only
    match /dashboard/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Inventory and event management - authenticated users only
    match /inventory/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /events/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /generalSales/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /generalOrders/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Backups - authenticated users only
    match /backups/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Catalog - public read, authenticated write
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact messages - allow public write, authenticated read
    match /contactMessages/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anyone to submit contact form
    }

    // Event bookings - allow public create (booking form), authenticated read/manage
    match /eventBookings/{document=**} {
      allow read, update, delete: if request.auth != null;
      allow create: if true; // Allow anyone to submit an event booking request
    }

    // Orders - written ONLY by Cloud Functions (Admin SDK bypasses these rules).
    // Clients can never create/forge an order (prevents fake "paid" orders).
    // Authenticated admins read orders and update status (e.g. mark shipped).
    match /orders/{document=**} {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    // Summer Reads registrations.
    // - Public can create a registration (validated below), but cannot set booksLogged
    //   counts/tier — those are managed only by the logSummerBook Cloud Function.
    // - Public can read a SINGLE doc by id (the child code) to view progress, but NOT
    //   list the collection (so codes aren't enumerable).
    // - Book logging + updates happen via Cloud Function (Admin SDK bypasses rules).
    // - Authenticated admins have full read; deletes are function/admin only.
    match /summerReads/{code} {
      allow get: if true;
      allow list: if request.auth != null; // admins only can enumerate
      allow create: if request.resource.data.childName is string
                    && request.resource.data.childName.size() > 0
                    && request.resource.data.parentEmail is string
                    && request.resource.data.booksCount == 0
                    && (!('_live' in request.resource.data) || request.resource.data._live == true);
      allow update, delete: if request.auth != null; // client logging goes through the function
    }

    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
